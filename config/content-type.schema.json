{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ghost.local/schemas/content-type.schema.json",
  "title": "Ghost Content Type Profile",
  "description": "Schema for a configurable content format scoped to a channel unless explicitly shared.",
  "type": "object",
  "additionalProperties": false,
  "required": ["content_type_id", "tenant_id", "name", "version", "status", "structure", "supported_platforms"],
  "properties": {
    "content_type_id": {"type": "string", "format": "uuid"},
    "tenant_id": {"type": "string", "minLength": 1},
    "owner_profile_id": {"type": ["string", "null"]},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "description": {"type": "string", "maxLength": 2000},
    "version": {"type": "integer", "minimum": 1},
    "status": {"type": "string", "enum": ["draft", "active", "disabled", "needs_review"]},
    "supported_platforms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "enum": ["youtube", "facebook", "instagram", "other"]}},
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_format", "sections"],
      "properties": {
        "output_format": {"type": "string", "enum": ["script", "scene_plan", "storyboard", "carousel_plan", "post_copy", "custom"]},
        "target_duration_seconds": {"type": ["integer", "null"], "minimum": 1, "maximum": 86400},
        "aspect_ratio": {"type": ["string", "null"], "enum": ["9:16", "16:9", "1:1", "4:5", "custom", null]},
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "required"],
            "properties": {
              "id": {"type": "string", "pattern": "^[a-z0-9_-]+$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 120},
              "required": {"type": "boolean"},
              "target_seconds": {"type": ["integer", "null"], "minimum": 0, "maximum": 86400},
              "instructions": {"type": "string", "maxLength": 4000}
            }
          }
        }
      }
    },
    "creative_rules": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "visual_rules": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "voice_rules": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "research_rules": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "quality_gates": {"type": "array", "items": {"type": "string", "maxLength": 2000}},
    "output_schema_ref": {"type": ["string", "null"], "maxLength": 500},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "created_by": {"type": "string", "maxLength": 200}
  }
}
