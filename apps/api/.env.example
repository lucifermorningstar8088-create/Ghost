# Configure only in the backend runtime environment. Never commit real credentials.
# Local PostgreSQL:
DATABASE_URL=postgresql+psycopg://ghost:change-me@localhost:5432/ghost
# Supabase Auth token verification. Replace with your project URL before use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides if your project uses a different issuer/JWKS URL:
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Never use the service-role key in frontend/VITE_* environment variables.
