# Configure only in the backend runtime environment. Never commit real credentials.
# Leave DATABASE_URL unset for local SQLite; set it only for hosted Supabase/PostgreSQL.
# DATABASE_URL=postgresql+psycopg://ghost:change-me@localhost:5432/ghost

# Required to encrypt saved social credentials on the API server.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep stable and secret. Never put this in a VITE_* variable.
GHOST_SECRET_ENCRYPTION_KEY=
# Supabase Auth token verification. Replace with your project URL before use.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_AUDIENCE=authenticated
# Optional overrides if your project uses a different issuer/JWKS URL:
# SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
# SUPABASE_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
# Never use the service-role key in frontend/VITE_* environment variables.

# Comma-separated browser origins allowed to read API health endpoints.
GHOST_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
